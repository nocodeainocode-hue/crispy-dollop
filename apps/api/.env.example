# --- Supabase (yalnızca Postgres; imza videoları sunucuda tutulmaz, telefonda kalır) ---
# Supabase panelinde: Project Settings > Database > Connection string > "Session pooler" (IPv4 uyumlu).
# [YOUR-PASSWORD] yerine veritabanı şifreni yaz. Bu dosyayı ve şifreyi KİMSEYLE paylaşma.
DATABASE_URL=postgresql://postgres.PROJE_REF:[YOUR-PASSWORD]@aws-0-BOLGE.pooler.supabase.com:5432/postgres

# --- Uygulama ---
ADMIN_PASSWORD=
JWT_SECRET=
SMTP_URL=
# Gönderen adres; alan adı Resend’de doğrulanmış olmalı
MAIL_FROM=QuitVow <no-reply@quitvow.com.tr>
APP_URL=
