{
  "expo": {
    "name": "QuitVow",
    "slug": "quitvow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0C",
    "android": {
      "package": "com.quitvow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "İmza videonu kaydetmek için kameraya erişim gerekiyor.",
          "microphonePermission": "İmza videonda sesini kaydetmek için mikrofona erişim gerekiyor.",
          "recordAudioAndroid": true
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "548f79bf-13da-4766-a61e-86d459eb258a"
      }
    },
    "owner": "ederdiyok"
  }
}
