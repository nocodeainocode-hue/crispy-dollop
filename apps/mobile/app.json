{
  "expo": {
    "name": "QuitVow",
    "slug": "quitvow",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4ECDB",
    "android": {
      "package": "com.quitvow.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4ECDB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "İmza videonu kaydetmek için kameraya erişim gerekiyor.",
          "microphonePermission": "İmza videonda sesini kaydetmek için mikrofona erişim gerekiyor.",
          "recordAudioAndroid": true
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECDB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1B2820",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "548f79bf-13da-4766-a61e-86d459eb258a"
      }
    },
    "owner": "ederdiyok"
  }
}
